# Copy to .env for local dev. Never commit the real .env file.

# Railway Postgres (provided by Railway as DATABASE_URL when the DB is provisioned)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Kalshi API
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# NWS/NOAA — api.weather.gov requires no API key, but a contact email is required in the User-Agent header
NWS_USER_AGENT_CONTACT=you@example.com

# Alerting (Phase 5+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety switch — must be explicitly set to true to place real orders (Phase 5+)
LIVE_TRADING_ENABLED=false
